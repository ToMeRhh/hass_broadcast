{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["frontend/src", "frontend/test", "frontend/dev"],
  // Compiled inside a home-assistant/frontend checkout, against its sources.
  "exclude": ["frontend/dev/editor"]
}
